{
  "info": {
    "name": "Sistema de Gestão de Chamados - Etapa 1 (Back-end)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demonstração da API REST do Sistema de Gestão de Chamados.\n\n**Antes de começar:** rode a API com `npm run dev` (pasta backend). A variável `baseUrl` aponta para `http://localhost:3333`.\n\n**Como usar:** execute as pastas na ordem (00 → 05). O login salva o token JWT automaticamente na variável `token`, e as rotas protegidas usam esse token pela autenticação da coleção (Bearer Token). A criação de categoria e de chamado também salva os ids.\n\nO email do usuário e o nome da categoria são gerados a cada execução, então é possível repetir a demonstração sem conflito."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "senha123"
    },
    {
      "key": "categoryName",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - API no ar",
      "description": "Confirma que o servidor está rodando.",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Rota pública que confirma que a API está no ar.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "01 - Autenticação",
      "description": "Cadastro com hash de senha (bcrypt) e login com emissão de JWT.",
      "item": [
        {
          "name": "Registrar usuário",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera um email novo a cada execução para evitar o erro 409 (email duplicado)",
                  "pm.collectionVariables.set('email', `usuario${Date.now()}@exemplo.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Não retorna a senha\", () => pm.expect(pm.response.json()).to.not.have.property(\"passwordHash\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Cria um usuário. A senha é salva como hash (bcrypt) e nunca é retornada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vitor Hugo\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (salva o token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Retorna o token JWT\", () => pm.expect(body.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Valida email e senha (bcrypt.compare) e retorna o JWT. O token fica salvo na variável `token` e é usado nas rotas protegidas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "02 - Categorias",
      "description": "Entidade relacionada: um chamado pertence a uma categoria.",
      "item": [
        {
          "name": "Listar categorias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories",
            "description": "Rota pública. Lista as categorias cadastradas.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Criar categoria (protegida)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Nome único a cada execução para evitar o erro 409 (categoria duplicada)",
                  "pm.collectionVariables.set('categoryName', `Impressoras ${Date.now() % 100000}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('categoryId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/categories",
            "description": "Exige JWT. O id criado fica salvo na variável `categoryId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{categoryName}}\",\n  \"description\": \"Problemas com impressão\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buscar categoria por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "description": "Mostra a categoria e quantos chamados ela possui (`_count.tickets`).",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "03 - Chamados (CRUD)",
      "description": "Entidade principal. Todas as rotas exigem JWT.",
      "item": [
        {
          "name": "Criar chamado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('ticketId', body.id);",
                  "pm.test(\"Nasce com status OPEN\", () => pm.expect(body.status).to.eql('OPEN'));",
                  "pm.test(\"O dono vem do JWT, não do userId 999 enviado\", () => pm.expect(body.userId).to.eql(Number(pm.collectionVariables.get('userId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tickets",
            "description": "O `userId: 999` enviado no corpo é ignorado: o dono do chamado é sempre o usuário do token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Impressora não liga\",\n  \"description\": \"A impressora do 2º andar não liga desde ontem\",\n  \"priority\": \"HIGH\",\n  \"categoryId\": {{categoryId}},\n  \"userId\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar chamados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets",
            "description": "Lista apenas os chamados do usuário autenticado, com usuário e categoria."
          }
        },
        {
          "name": "Buscar chamado por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "description": "Busca um chamado do usuário autenticado."
          }
        },
        {
          "name": "Atualizar chamado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "description": "Atualiza os campos enviados (validados com Zod).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Impressora do 2º andar não liga\",\n  \"priority\": \"MEDIUM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Alterar status para IN_PROGRESS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status alterado\", () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "description": "Status aceitos: OPEN, IN_PROGRESS, RESOLVED, CLOSED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Alterar status para RESOLVED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status alterado\", () => pm.expect(pm.response.json().status).to.eql('RESOLVED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Excluir chamado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "description": "Exclui o chamado."
          }
        },
        {
          "name": "Buscar chamado excluído (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "description": "Confirma que o chamado foi excluído."
          }
        }
      ]
    },
    {
      "name": "04 - Usuários",
      "description": "Leitura de entidade relacionada.",
      "item": [
        {
          "name": "Buscar usuário por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Não retorna a senha\", () => pm.expect(pm.response.json()).to.not.have.property(\"passwordHash\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Retorna apenas os dados públicos do usuário (sem passwordHash)."
          }
        }
      ]
    },
    {
      "name": "05 - Erros e segurança",
      "description": "Validação (400), autenticação (401), recurso inexistente (404) e conflito (409), todos tratados pelo middleware central de erros.",
      "item": [
        {
          "name": "Rota protegida sem token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tickets",
            "description": "Sem o header Authorization a API responde 401.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Token inválido (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token-falso"
              }
            ],
            "url": "{{baseUrl}}/tickets",
            "description": "Token adulterado ou expirado responde 401.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Cadastro com dados inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Lista os campos inválidos\", () => pm.expect(pm.response.json().details).to.have.length(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "O Zod valida antes da regra de negócio e informa cada campo inválido.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"V\",\n  \"email\": \"email-invalido\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Email já cadastrado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Regra de negócio: não permite email duplicado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vitor Hugo\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login com senha errada (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"senha-errada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Prioridade inválida (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tickets",
            "description": "priority aceita apenas LOW, MEDIUM ou HIGH.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Teste\",\n  \"description\": \"Teste de validação\",\n  \"priority\": \"URGENTE\",\n  \"categoryId\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Categoria inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tickets",
            "description": "Regra de negócio: o chamado precisa pertencer a uma categoria existente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Teste\",\n  \"description\": \"Categoria que não existe\",\n  \"categoryId\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Atualizar chamado inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tickets/999999",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Excluir chamado inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tickets/999999"
          }
        }
      ]
    }
  ]
}
