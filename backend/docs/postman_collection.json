{
  "info": {
    "name": "Sistema de Gestão de Chamados",
    "description": "Fluxo de demonstração da API. Execute as requisições na ordem: o login salva o token e a criação de categoria/chamado salva os ids automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "ticketId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Registrar usuário",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Usuário Demo\",\n  \"email\": \"demo@exemplo.com\",\n  \"password\": \"senha123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "02 - Login (salva o token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.token) { pm.collectionVariables.set('token', body.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@exemplo.com\",\n  \"password\": \"senha123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "03 - Listar categorias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      }
    },
    {
      "name": "04 - Criar categoria",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.id) { pm.collectionVariables.set('categoryId', body.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Impressoras\",\n  \"description\": \"Problemas com impressão\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      }
    },
    {
      "name": "05 - Buscar categoria por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories",
            "{{categoryId}}"
          ]
        }
      }
    },
    {
      "name": "06 - Criar chamado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.id) { pm.collectionVariables.set('ticketId', body.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Impressora não liga\",\n  \"description\": \"A impressora do 2º andar não liga desde ontem\",\n  \"priority\": \"HIGH\",\n  \"categoryId\": {{categoryId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 - Listar chamados",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        }
      }
    },
    {
      "name": "08 - Buscar chamado por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    },
    {
      "name": "09 - Atualizar chamado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Impressora do 2º andar não liga\",\n  \"priority\": \"MEDIUM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    },
    {
      "name": "10 - Alterar status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    },
    {
      "name": "11 - Buscar usuário por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "1"
          ]
        }
      }
    },
    {
      "name": "12 - Excluir chamado",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    },
    {
      "name": "13 - Rota protegida sem JWT (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        }
      }
    }
  ]
}
