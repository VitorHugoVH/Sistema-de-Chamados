# ---------------------------------------------------------------
# Banco de dados (Supabase / PostgreSQL)
# Copie as strings em: Supabase > projeto > botão "Connect" > ORMs > Prisma
# Substitua [SENHA-DO-BANCO] pela senha definida ao criar o projeto.
# ---------------------------------------------------------------

# Usada pela API: pooler em modo "transaction" (porta 6543)
DATABASE_URL="postgresql://postgres.[ID-DO-PROJETO]:[SENHA-DO-BANCO]@[HOST-DO-POOLER]:6543/postgres?pgbouncer=true"

# Usada pelas migrations do Prisma: pooler em modo "session" (porta 5432)
DIRECT_URL="postgresql://postgres.[ID-DO-PROJETO]:[SENHA-DO-BANCO]@[HOST-DO-POOLER]:5432/postgres"

# Para PostgreSQL local, use a mesma string nas duas variáveis, por exemplo:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_chamados?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gestao_chamados?schema=public"

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Tempo de expiração do token JWT (ex.: 1h, 1d)
JWT_EXPIRES_IN="1d"

# Porta da API
PORT=3333

# Origem(ns) permitida(s) pelo CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:3000"

# Ambiente: development | production | test
NODE_ENV=development
