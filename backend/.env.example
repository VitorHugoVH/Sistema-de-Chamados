# String de conexão do PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_chamados?schema=public"

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Tempo de expiração do token JWT (ex.: 1h, 1d)
JWT_EXPIRES_IN="1d"

# Porta da API
PORT=3333

# Origem(ns) permitida(s) pelo CORS, separadas por vírgula (ex.: front-end Next.js)
CORS_ORIGIN="http://localhost:3000"

# Ambiente: development | production | test
NODE_ENV=development
